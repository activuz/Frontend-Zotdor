<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Edge-to-edge (Android 15+ enforces it): MainActivity pads the content for the system
         bars and paints the bar areas with the ink colour, like the site's header. -->
    <style name="Theme.Zotdor" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>

    <style name="Theme.Zotdor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Zotdor</item>
    </style>
</resources>
