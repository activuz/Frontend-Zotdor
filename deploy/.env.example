# Copy to deploy/.env (git-ignored). Application secrets live in backend/.env.
DOMAIN=web.zotdor.uz
PANEL_DOMAIN=panel.zotdor.uz
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# backup.sh: where nightly copies go (rsync target on another server) and how long they live.
BACKUP_DIR=/var/backups/zotdor
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
