# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit it.

DJANGO_DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Local role must have CREATEDB so tests can create their own database.
DATABASE_URL=postgres://zotdor:CHANGE_ME@localhost:5432/zotdor

MEDIA_ROOT=
LOG_LEVEL=INFO

# Phase 1 — get from @BotFather. Do not paste tokens into chats or issues.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Phase 8 — Click merchant credentials (after contract). fake = local stub.
PAYMENTS_PROVIDER=fake
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
