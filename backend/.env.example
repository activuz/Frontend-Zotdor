# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit it.
# Production values for Render are listed in render.yaml and docs/DEPLOYMENT.md.

DJANGO_DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Host names that reach THIS API, without scheme. Production: api.zotdor.uz,zotdor-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Sites allowed to call the API from the browser, with scheme.
# Production: https://web.zotdor.uz,https://panel.zotdor.uz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Split hosting only (SPA and API on different subdomains): .zotdor.uz. Empty for same origin.
CSRF_COOKIE_DOMAIN=

# Local role must have CREATEDB so tests can create their own database.
# Nhost: postgres://postgres:<password>@<subdomain>.db.<region>.nhost.run:5432/<subdomain>?sslmode=require
DATABASE_URL=postgres://zotdor:CHANGE_ME@localhost:5432/zotdor

# File storage: local (MEDIA_ROOT, VPS/development) or nhost (Render production).
STORAGE_BACKEND=local
MEDIA_ROOT=
# Nhost only: https://<subdomain>.storage.<region>.nhost.run and the project admin secret.
NHOST_STORAGE_URL=
NHOST_ADMIN_SECRET=
NHOST_PUBLIC_BUCKET=media-public
NHOST_PRIVATE_BUCKET=media-private
LOG_LEVEL=INFO

# Get from @BotFather. Do not paste tokens into chats or issues.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Staff chat id (user or group) that receives landing-page contact requests. Empty = off.
LEADS_TELEGRAM_CHAT_ID=
# Public site origin for links in Telegram messages and payment returns.
FRONTEND_URL=http://localhost:3000

# Click merchant credentials (after contract). fake = local stub (works only with DEBUG=true).
PAYMENTS_PROVIDER=fake
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
