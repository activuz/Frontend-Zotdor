# B reja: API va worker shu kompyuterda (docs/SELFHOST.md).
# Nusxa oling: selfhost/.env (git'ga tushmaydi). backend/.env bu rejimda O'QILMAYDI.

# --- Ommaviy manzil ---------------------------------------------------------------------
# 1-variant (tavsiya): ngrok pullik tarif + o'z domeningiz. Vercel'da hech narsa o'zgarmaydi.
PUBLIC_API_URL=https://api.zotdor.uz
NGROK_DOMAIN=api.zotdor.uz
# 2-variant: ngrok bepul doimiy domeni (dashboard.ngrok.com -> Domains). Unda:
#   PUBLIC_API_URL=https://<nom>.ngrok-free.app   NGROK_DOMAIN=<nom>.ngrok-free.app
#   ALLOWED_HOSTS ga shu domen, CSRF_COOKIE_DOMAIN= (bo'sh), COOKIE_SAMESITE=None,
#   va Vercel'da VITE_API_URL / NEXT_PUBLIC_API_URL hamda vercel.json CSP'ni o'zgartiring.

# --- Django ---------------------------------------------------------------------------------
DJANGO_DEBUG=false
# python -c "import secrets; print(secrets.token_urlsafe(50))"  (Render'dagi bilan bir xil bo'lsa,
# foydalanuvchilar qayta kirishi shart bo'lmaydi)
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=api.zotdor.uz,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://web.zotdor.uz,https://panel.zotdor.uz,https://zotdor.uz,https://www.zotdor.uz
CSRF_TRUSTED_ORIGINS=https://web.zotdor.uz,https://panel.zotdor.uz
CSRF_COOKIE_DOMAIN=.zotdor.uz
COOKIE_SAMESITE=Lax
FRONTEND_URL=https://web.zotdor.uz
LOG_LEVEL=INFO

# --- Baza -----------------------------------------------------------------------------------
# API faqat LOKAL bazaga ulanadi (start.ps1 tekshiradi): uydan Nhost'ga har so'rov uzoq yo'l.
DATABASE_URL=postgres://zotdor:CHANGE_ME@localhost:5432/zotdor
# Faqat db-from-nhost.ps1 / db-to-nhost.ps1 uchun. ?sslmode=require bilan.
NHOST_DATABASE_URL=postgres://postgres:<parol>@<subdomain>.db.<region>.nhost.run:5432/<subdomain>?sslmode=require
PG_BIN=C:\Program Files\PostgreSQL\19\bin

# --- Fayllar: Nhost'da qoladi (rasm va videolar ko'chirilmaydi) -----------------------------
STORAGE_BACKEND=nhost
NHOST_STORAGE_URL=https://<subdomain>.storage.<region>.nhost.run
NHOST_ADMIN_SECRET=
NHOST_PUBLIC_BUCKET=media-public
NHOST_PRIVATE_BUCKET=media-private
MEDIA_PROCESS_SYNC=false
# PATH'da bo'lmasa to'liq yo'l: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- Telegram, push, to'lov (Render'dagi qiymatlar) -----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ZotdorPlatformBot
TELEGRAM_WEBHOOK_SECRET=
LEADS_TELEGRAM_CHAT_ID=
SUPPORT_TELEGRAM_CHAT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY= I guess you can use
VAPID_SUBJECT=https://web.zotdor.uz
# Fayl yo'li backend/ papkasiga nisbatan
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
PAYMENTS_PROVIDER=click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# --- Jarayonlar -----------------------------------------------------------------------------
PORT=8000
WEB_THREADS=8
WORKER_CONCURRENCY=4
